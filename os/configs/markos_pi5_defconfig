# MarkOS — Raspberry Pi 5 (16 GB) LLM inference appliance
# Based on buildroot 2025.02 configs/raspberrypi5_defconfig (symbols verified
# against that release), extended for the appliance: runit supervision,
# dropbear, WPA3, avahi, nftables, resize2fs/sfdisk, libgpiod, markos-engine.
# Built via: os/build.sh  →  make BR2_EXTERNAL=../os markos_pi5_defconfig

# --- platform (matches upstream raspberrypi5_defconfig @ 2025.02) ---
BR2_aarch64=y
BR2_cortex_a76=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches"
BR2_SYSTEM_DHCP="eth0"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,4bb240615790ea5bd939484f4595b6952ac94ef4)/linux-4bb240615790ea5bd939484f4595b6952ac94ef4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/kernel-markos.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_RPI_FIRMWARE=y
# Pi 5 boots with the start4.elf/fixup4.dat pair (no bootcode.bin — its
# bootcode lives in EEPROM; the PI4 variant is just how the package names
# the -4 firmware files the BCM2712 loads).
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/config_5.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/cmdline.txt"
# BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS is not set

# --- identity / security baseline ---
BR2_TARGET_GENERIC_HOSTNAME="markos"
BR2_TARGET_GENERIC_BANNER="MarkOS inference appliance"
# root account locked: SSH is key-only dropbear, no shell login by default
BR2_TARGET_GENERIC_ROOT_PASSWD="*"
BR2_SYSTEM_BIN_SH_BUSYBOX=y

# --- supervision & services ---
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_S6=y
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_PASSWORD_AUTH is not set
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_AVAHI_AUTOIPD=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_WIFI_DISPLAY=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_HOTSPOT=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# --- firewall, storage, recovery tooling ---
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
# BR2_PACKAGE_E2FSPROGS_FSCK is not set
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_LIBGPIOD_TOOLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# TLS for the model downloader: without a backend, the image's curl speaks
# plain HTTP only and every HF download fails ("Protocol https not supported").
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_TZDATA=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_XZ=y

# --- MarkOS engine (custom serving layer + llama.cpp via cargo) ---
BR2_PACKAGE_MARKOS_ENGINE=y
BR2_PACKAGE_MARKOS_ENGINE_TLS=y

# --- image layout (see board/markos/genimage-*.cfg) ---
# SD variant ships squashfs root (read-only); SSD/NVMe variant ships ext4.
# os/build.sh switches this line per variant.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_XZ=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
# Appliance runtime: init scripts, s6 services, firewall, update/recovery tools
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_MARKOS_PATH)/board/markos"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
