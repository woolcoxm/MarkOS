# /etc/inittab — MarkOS (busybox init): boot stages, then runit supervision.
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/hostname -F /etc/hostname
::sysinit:/etc/init.d/rcS

# Service supervision (s6): engine, avahi, watchdogd, boot-confirm (+dropbear).
# busybox init respawns s6-svscan; s6-supervise restarts each service.
::respawn:/bin/s6-svscan -t 5000 /etc/service

# Local debug console (HDMI keyboard) — the real recovery paths are
# UART/link-local/factory-reset (docs/recovery.md).
tty1::respawn:/sbin/getty -L tty1 115200 vt100

# Put a getty on the serial console (recovery path 1). The wrapper stays
# dormant when the UART node is absent (e.g. under QEMU, where the PL011
# enumerates as ttyAMA0) instead of respawning getty in a tight loop.
::respawn:/usr/bin/markos-serial-getty

::shutdown:/etc/init.d/rcK
::shutdown:/bin/umount -a -r
