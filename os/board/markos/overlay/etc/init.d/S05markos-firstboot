#!/bin/sh
# S05markos-firstboot — grow the data partition to fill the media, once.
#
# Runs DETACHED: busybox init starts the supervised services only after
# rcS completes, and resize2fs on a large card can run for minutes — the
# appliance must come up on the network first. Growing the mounted ext4
# online is safe (kernel-side resize).
#
# This buildroot has no sfdisk package symbol; partition 4's sector count
# is patched directly in the MBR (LE32 at byte offset 506 = entry 4 at
# 446+3*16, field +12), partx informs the kernel, resize2fs grows the fs.

FLAG=/data/state/.expanded
[ -e "$FLAG" ] && exit 0

DISK=""
for cand in /dev/mmcblk0 /dev/vda /dev/nvme0n1 /dev/sda; do
	if [ -b "$cand" ]; then DISK="$cand"; break; fi
done
[ -n "$DISK" ] || exit 0

(
	if command -v resize2fs >/dev/null 2>&1 && command -v partx >/dev/null 2>&1; then
		BASE="/sys/block/$(basename "$DISK")"
		TOTAL=$(cat "$BASE/size")
		P4="${DISK}4"
		[ -b "$P4" ] || P4="${DISK}p4"
		START=$(cat "$BASE/$(basename "$P4")/start")
		COUNT=$((TOTAL - START))

		dd if="$DISK" of=/tmp/mbr.bin bs=512 count=1 >/dev/null 2>&1
		printf "$(printf '\\%03o\\%03o\\%03o\\%03o' \
			$((COUNT & 255)) $(((COUNT >> 8) & 255)) \
			$(((COUNT >> 16) & 255)) $(((COUNT >> 24) & 255)))" > /tmp/cnt.bin
		dd if=/tmp/cnt.bin of=/tmp/mbr.bin bs=1 seek=506 count=4 conv=notrunc >/dev/null 2>&1
		dd if=/tmp/mbr.bin of="$DISK" bs=512 count=1 conv=notrunc >/dev/null 2>&1
		partx -u "$DISK" >/dev/null 2>&1 || true

		if resize2fs "$P4" >/dev/null 2>&1; then
			touch "$FLAG"
			echo "markos-firstboot: data partition expanded to $((COUNT / 2048)) MiB on $DISK" >/dev/console
		else
			echo "markos-firstboot: resize2fs failed on $P4 (will retry next boot)" >/dev/console
		fi
		rm -f /tmp/mbr.bin /tmp/cnt.bin
	fi
) &

exit 0
