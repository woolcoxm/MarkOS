#!/bin/sh
# S03markos-net — v8: NETWORK FIRST, no timeout wrappers (this busybox has
# no `timeout` applet — a wrapped command is a silently SKIPPED command,
# which is how the static config was decided but never applied).
T() { /usr/bin/markos-trace "S03: $*"; }

T "start"

# ---- 1. NETWORK FIRST: nothing below may block before the interface serves
IFACE="eth0"
MODE="dhcp"
mkdir -p /data/state
# adopt the installer plan (FAT) if state is missing
for f in net.conf ssh-enabled; do
	if [ ! -f "/data/state/$f" ] && [ -f "/boot/markos/$f" ]; then
		cp "/boot/markos/$f" "/data/state/$f"
	fi
done
[ -f /data/state/net.conf ] && . /data/state/net.conf
# SELF-HEAL: FAT plan wins if state is absent or drifted to dhcp
if [ "$MODE" = "dhcp" ] && [ -f /boot/markos/net.conf ]; then
	grep -q '^MODE=static' /boot/markos/net.conf && {
		. /boot/markos/net.conf
		cp /boot/markos/net.conf /data/state/net.conf
		T "self-heal: adopted static plan from FAT"
	}
fi
T "1-config: iface=$IFACE mode=$MODE ip=${IP:-none}"

ip link set lo up 2>/dev/null
ip link set "$IFACE" up 2>/dev/null
case "$MODE" in
	static)
		ip addr flush dev "$IFACE" 2>/dev/null
		ip addr add "${IP:-192.168.1.50}/24" dev "$IFACE"
		[ -n "$GW" ] && ip route add default via "$GW" dev "$IFACE"
		echo "nameserver ${DNS1:-1.1.1.1}" > /etc/resolv.conf
		[ -n "$DNS2" ] && echo "nameserver $DNS2" >> /etc/resolv.conf
		command -v arping >/dev/null 2>&1 && \
			arping -U -c 3 -I "$IFACE" "${IP:-192.168.1.50}" >/dev/null 2>&1 &
		echo "markos-net: static ${IP:-192.168.1.50}/24 on $IFACE gw ${GW:-none}" >/dev/console
		;;
	*)
		udhcpc -b -i "$IFACE" -p /var/run/udhcpc.pid -x hostname:"$(hostname)" >/dev/null 2>&1 &
		;;
esac
ip addr add 169.254.9.1/16 dev "$IFACE" 2>/dev/null
T "2-interface-up"

# ---- 2. hostname / tz / locale
[ -f /data/state/hostname ] && { hostname -F /data/state/hostname; cp /data/state/hostname /etc/hostname; }
[ -s /data/state/tz ] && cp /data/state/tz /etc/TZ
[ -s /data/state/lang ] && {
	echo "export LANG=$(cat /data/state/lang)" > /etc/profile.d/00-lang.sh
	echo "export LC_ALL=$(cat /data/state/lang)" >> /etc/profile.d/00-lang.sh
}
T "3-host-tz done"

# ---- 3. dropbear keys (persisted; keygen only ever runs on a truly fresh /data)
[ -d /data/state/dropbear ] || mkdir -p /data/state/dropbear
if [ -n "$(ls /data/state/dropbear 2>/dev/null)" ]; then
	mkdir -p /etc/dropbear
	cp -a /data/state/dropbear/. /etc/dropbear/
fi
if [ -x /usr/bin/dropbearkey ] && [ ! -f /etc/dropbear/dropbear_rsa_host_key ]; then
	mkdir -p /etc/dropbear
	/usr/bin/dropbearkey -t rsa -f /etc/dropbear/dropbear_rsa_host_key >/dev/null 2>&1 || true
fi
[ -d /etc/dropbear ] && cp -a /etc/dropbear/. /data/state/dropbear/ 2>/dev/null
T "4-dropbear done"

[ -f /boot/markos/authorized_keys ] && {
	mkdir -p /root/.ssh
	cp /boot/markos/authorized_keys /root/.ssh/authorized_keys
	chmod 600 /root/.ssh/authorized_keys
}

# ---- 4. provision snapshot (factory-reset source)
if [ -f /boot/markos/provision.env ] || [ -f /boot/markos/net.conf ]; then
	mount -o remount,rw /boot 2>/dev/null || true
	mkdir -p /boot/markos-snapshot
	for f in provision.env net.conf; do
		[ -f "/boot/markos/$f" ] && cp "/boot/markos/$f" "/boot/markos-snapshot/$f"
	done
	sync
	mount -o remount,ro /boot 2>/dev/null || true
fi
T "5-snapshot done"

# ---- 5. ntp + mDNS name + LED heartbeat
command -v ntpd >/dev/null 2>&1 && ntpd -N -p pool.ntp.org >/dev/null 2>&1 &
MDNS="$(sed -n 's/.*"mdns_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' /var/lib/markos/markos.json 2>/dev/null | head -n1)"
[ -n "$MDNS" ] && [ -f /etc/avahi/avahi-daemon.conf ] && \
	sed -i "s/^host-name=.*/host-name=$MDNS/" /etc/avahi/avahi-daemon.conf
[ -w /sys/class/leds/ACT/trigger ] && echo heartbeat > /sys/class/leds/ACT/trigger 2>/dev/null
T "6-done — S03 COMPLETE"

exit 0
